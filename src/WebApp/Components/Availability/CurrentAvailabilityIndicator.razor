@using Domain.Application
@using WebApp.Components.UI
@inject GymAvailabilityQueryService QueryService

<h1 class="text-2xl">Available Slots</h1>

@if (_loading)
{
    <div class="text-xl">Loading...</div>
}
else
{
    <div class="p-3 w-20 text-center rounded text-xl"
         style="background-color: @(AvailabilityStatusColor.GetColorForAvailability((double)_availability.Value))">
        @_availability.Value
    </div>
}

@code {
    [Parameter] public Guid GymId { get; set; }
    private Guid _lastGymId;
    
    private int? _availability;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        if (GymId == _lastGymId)
            return;

        _lastGymId = GymId;
        _loading = true;

        _availability = await QueryService.GetLatestAvailability(
            GymId,
            CancellationToken.None
        );

        _loading = false;
    }
}