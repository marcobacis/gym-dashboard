@using Domain.Application
@inject GymAvailabilityQueryService QueryService

<h1 class="text-2xl">Available Slots</h1>

@if (_loading)
{
    <div class="text-xl">Loading...</div>
}
else
{
    <div class="p-3 w-20 text-center rounded text-xl"
         style="background-color: @(AvailabilityStatusColor.GetColorForAvailability(_availability.Value / (Max-Min)))">
        @_availability.Value
    </div>
}

@code {
    [Parameter] public Guid GymId { get; set; }
    [Parameter] public int Max { get; set; } = 130;
    [Parameter] public int Min { get; set; } = 0;
    
    private int? _availability;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;

        _availability = await QueryService.GetLatestAvailability(
            GymId,
            CancellationToken.None
        );

        _loading = false;
    }
}