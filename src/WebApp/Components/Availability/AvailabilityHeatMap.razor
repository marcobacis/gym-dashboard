@using ApexCharts
@using Domain.Application
@using WebApp.Components.UI

<div class="w-full h-[300px]">
    <ApexChart TItem="AvailabilityHourResponse"
               Options="_options"
               Height = "@("100%")"
    >

        @foreach (var day in _chartData.GroupBy(e => e.DayOfWeek).OrderByDescending(e => (int)e.Key))
        {
            <ApexPointSeries TItem="AvailabilityHourResponse"
                             Items="day.OrderBy(e=>e.Hour)"
                             Name="@day.Key.ToString().Substring(0, 3)"
                             SeriesType="SeriesType.Heatmap"
                             
                             XValue="@(e => $"{e.Hour}:00")"
                             YAggregate="@(e => (int)e.Average(a => a.Seats))"
            />
        }

    </ApexChart>
</div>

@code {
    private Guid _lastGymId;
    [Parameter] public Guid GymId { get; set; }

    [Inject] protected GymAvailabilityQueryService QueryService { get; set; }

    private List<AvailabilityHourResponse> _chartData = new();
    private readonly ApexChartOptions<AvailabilityHourResponse> _options = new()
    {
        Legend = new Legend()
        {
            Show = false,
        },
        PlotOptions = new PlotOptions
        {
            Heatmap = new PlotOptionsHeatmap
            {
                EnableShades = true,
                ShadeIntensity = 0.7,
                ColorScale = new PlotOptionsHeatmapColorScale
                {
                    Min = 0,
                    Max = 130,
                    Inverse = false,
                    Ranges = AvailabilityStatusColor.GetHeatMapRanges()
                }
            }
        }
    };
    
    protected override async Task OnInitializedAsync()
    {
        await LoadChart();
    }
    
    protected override async Task OnParametersSetAsync()
    {
        if (!GymId.Equals(_lastGymId))
        {
            await LoadChart();
        }
    }

    private async Task LoadChart()
    {
        _chartData = await QueryService.GetAvailabilityByByHour(GymId, CancellationToken.None);

        // Fill in missing hours with -1 seats
        foreach (var day in Enum.GetValues<DayOfWeek>())
        {
            for (int hour = 0; hour < 24; hour++)
            {
                var exist = _chartData.Any(e => e.DayOfWeek == day && e.Hour == hour);
                if (!exist)
                {
                    _chartData.Add(new AvailabilityHourResponse
                    {
                        DayOfWeek = day,
                        Hour = hour,
                        Seats = -1
                    });
                }
            }
        }

        // Gym location (for now?)
        var timeZone = TimeZoneInfo.FindSystemTimeZoneById("W. Europe Standard Time");
            
        _chartData = _chartData.Select(e =>
            new AvailabilityHourResponse
            {
                DayOfWeek = e.DayOfWeek,
                Hour = (e.Hour + timeZone.BaseUtcOffset.Hours),
                Seats = e.Seats
            }
        ).ToList();

        // Remove night hours (22-6)
        _chartData = _chartData.Where(e => e.Hour >= 5 && e.Hour <= 24).ToList();
    }
}