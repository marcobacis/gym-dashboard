@rendermode InteractiveServer
@using ApexCharts
@using Domain.Application

<div class="w-full h-[300px] mt-3">

    <div class="flex items-center justify-center space-x-2 gap-2">
        <button @onclick="() => LoadYesterday()"
                class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
            &lt;
        </button>
    <InputDate TValue="DateTimeOffset" @bind-Value:get="_today" @bind-Value:set="LoadChart"></InputDate>
        <button @onclick="() => LoadTomorrow()"
                class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
            &gt;
        </button>
    </div>
    
    <ApexChart @key="_today" TItem="AvailabilityItemResponse"
               Height="@("100%")" Options="_options">
        <ApexPointSeries
            TItem="AvailabilityItemResponse"
            Items="_chartData"
            Name="Available Seats"
            SeriesType="SeriesType.Line"
            XValue="@(e => e.Time)"
            YValue="@(e => e.AvailableSeats)"/>
    </ApexChart>
</div>

@code {
    [Parameter] public Guid GymId { get; set; }
    private Guid _lastGymId;
    
    [Inject] protected GymAvailabilityQueryService QueryService { get; set; }

    [Inject] protected TimeProvider TimeProvider { get; set; }

    private DateTimeOffset _today = DateTimeOffset.Now;

    private DateTime _todayStart;
    private DateTime _todayEnd;

    private ApexChartOptions<AvailabilityItemResponse> _options;

    private List<AvailabilityItemResponse> _chartData = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadChart(TimeProvider.GetUtcNow());
    }
    
    protected override async Task OnParametersSetAsync()
    {
        if (!GymId.Equals(_lastGymId))
        {
            await LoadChart(TimeProvider.GetUtcNow());
        }
    }
    
    private async Task LoadYesterday()
    {
        _today = _today.AddDays(-1);
        await LoadChart(_today);
    }
    
    private async Task LoadTomorrow()
    {
        _today = _today.AddDays(1);
        await LoadChart(_today);
    }
    
    private async Task LoadChart(DateTimeOffset date)
    {
        _today = date;
        _todayStart = DateTime.SpecifyKind(date.UtcDateTime.Date, DateTimeKind.Utc);
        _todayEnd   = _todayStart.AddDays(1);
        
        _chartData = await QueryService.GetAvailabilityItems(GymId, _todayStart, _todayEnd, CancellationToken.None);
        
        // Ensure chart covers full day
        if (_chartData.Count == 0 || _chartData.Max(x => x.Time) < _todayEnd)
        {
            _chartData = _chartData
                .Append(new AvailabilityItemResponse
                {
                    Time = _todayEnd,
                    AvailableSeats = null
                })
                .ToList();
        }
        
        
        LoadChartOptions();

        StateHasChanged();
    }

    private void LoadChartOptions()
    {
        _options = new()
        {
            Tooltip = new Tooltip
            {
                X = new TooltipX
                {
                    Formatter = @"
                        function (value) {
                            const d = new Date(value);
                            return d.toLocaleString(undefined, {
                                day: '2-digit',
                                month: 'short',
                                hour: '2-digit',
                                minute: '2-digit'
                            });
                        }
                    "
                }
            },
            Yaxis = new List<YAxis>()
            {
                new()
                {
                    Min = 0,
                    Max = 130,
                    TickAmount = 13,
                }
            },
            Xaxis = new XAxis
            {
                Type = XAxisType.Datetime,
                Min = _todayStart,
                Max = _todayEnd,
                Labels = new XAxisLabels
                {
                    ShowDuplicates = false,
                    DatetimeUTC = true,
                    Format = "HH:mm"
                }
            }
        };
    }
}