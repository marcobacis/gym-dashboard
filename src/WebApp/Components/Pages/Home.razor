@page "/"
@rendermode InteractiveServer
@using Domain.Application
@using ApexCharts
@using WebApp.Components.UI
@using WebApp.Utils
@inject GymAvailabilityService Service
@inject BrowserTimeProvider TimeProvider

<InitializeTimeZone />

<PageTitle>Gym Dashboard</PageTitle>

<div class="flex flex-col items-center gap-4 p-3">
    <h1 class="text-2xl">Available Slots</h1>

    @if (_loading)
    {
        <div class="text-xl">Loading...</div>
    }
    else
    {
        <div class="p-3 w-20 text-center rounded text-xl"
             style="background-color: @(AvailabilityStatusColor.GetColorForAvailability((double)_availability.Value))">
            @_availability.Value
        </div>

        <div class="heatmap-container">

            <ApexChart TItem="AvailabilityHourResponse"
                       Options="options"
            >

                @foreach (var day in _chartData.GroupBy(e => e.DayOfWeek).OrderByDescending(e => (int)e.Key))
                {
                    <ApexPointSeries TItem="AvailabilityHourResponse"
                                     Items="day.OrderBy(e=>e.Hour)"
                                     Name="@day.Key.ToString().Substring(0, 3)"
                                     SeriesType="SeriesType.Heatmap"
                                     XValue="@(e => $"{e.Hour}:00")"
                                     YAggregate="@(e => (int)e.Average(a => a.Seats))"
                    />
                }

            </ApexChart>
        </div>
    }

</div>

@code {
    private bool _loading = true;
    private int? _availability;
    private List<AvailabilityHourResponse> _chartData = new();

    private ApexChartOptions<AvailabilityHourResponse> options = new()
    {
        Legend = new Legend()
        {
            Show = false,
        },
        PlotOptions = new PlotOptions
        {
            Heatmap = new PlotOptionsHeatmap
            {
                EnableShades = true,
                ShadeIntensity = 0.7,
                ColorScale = new PlotOptionsHeatmapColorScale
                {
                    Min = 0,
                    Max = 130,
                    Inverse = false,
                    Ranges = BuildRanges()
                }
            }
        }
    };

    protected override async Task OnInitializedAsync()
    {
        _availability = await Service.GetCurrentAvailability(CancellationToken.None);
        _chartData = await Service.GetAvailabilityMap(CancellationToken.None);

        // Fill in missing hours with -1 seats
        foreach (var day in Enum.GetValues<DayOfWeek>())
        {
            for (int hour = 0; hour < 24; hour++)
            {
                var exist = _chartData.Any(e => e.DayOfWeek == day && e.Hour == hour);
                if (!exist)
                {
                    _chartData.Add(new AvailabilityHourResponse
                    {
                        DayOfWeek = day,
                        Hour = hour,
                        Seats = -1
                    });
                }
            }
        }

        // Change hour from utc to local
        var offset = TimeProvider.LocalTimeZone.BaseUtcOffset.Hours;
        _chartData = _chartData.Select(e =>
            new AvailabilityHourResponse
            {
                DayOfWeek = e.DayOfWeek,
                Hour = (e.Hour + offset) % 24,
                Seats = e.Seats
            }
        ).ToList();

        // Remove night hours (22-6)
        _chartData = _chartData.Where(e => e.Hour >= 6 && e.Hour <= 22).ToList();

        _loading = false;
    }

    private static List<PlotOptionsHeatmapColorScaleRange> BuildRanges()
    {
        var ranges = new List<PlotOptionsHeatmapColorScaleRange>();

        ranges.Add(new PlotOptionsHeatmapColorScaleRange
        {
            From = -10,
            To = -1,
            Color = "#FFFFFF"
        });
        for (int i = 0; i < 130; i += 5)
        {
            ranges.Add(new PlotOptionsHeatmapColorScaleRange
            {
                From = i,
                To = i + 5,
                Color = AvailabilityStatusColor.GetColorForAvailability(i)
            });
        }

        return ranges;
    }

}